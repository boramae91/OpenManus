# 필수: OpenAI API 키 (실제 키를 입력하세요)
# OpenAI 플랫폼(https://platform.openai.com/api-keys)에서 발급받은 API 키를 입력하세요
# API 키가 없거나 잘못되면 분석이 실행되지 않습니다
OPENAI_API_KEY=your_openai_api_key_here

# 선택사항: DART API 키 (한국 기업 더 상세한 정보를 위함)
# DART 전자공시시스템(https://opendart.fss.or.kr/)에서 발급받은 API 키를 입력하세요
# DART API 키가 없어도 기본 분석은 가능합니다
DART_API_KEY=your_dart_api_key_here

# LLM 모델 설정 (기본값: gpt-4o)
# 사용할 GPT 모델을 지정합니다 (gpt-4o 권장)
LLM_MODEL=gpt-4o
