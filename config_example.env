# 🔑 OpenManus 대시보드 환경변수 설정 파일
#
# 이 파일은 OpenManus 대시보드가 필요한 API 키들을 설정하는 곳이에요.
# 마치 집 열쇠처럼, 각종 서비스에 접근하기 위한 비밀번호들을 여기에 저장해요!
#
# 사용법:
# 1. 이 파일을 복사해서 '.env' 파일로 이름을 바꿔주세요
# 2. 아래의 YOUR_API_KEY_HERE 부분을 실제 API 키로 바꿔주세요
# 3. 대시보드를 실행하면 자동으로 이 설정들이 적용됩니다!

# 🤖 OpenAI API 키 (필수!)
# OpenAI GPT-4o 모델을 사용하기 위한 API 키입니다.
# https://platform.openai.com/api-keys 에서 발급받을 수 있어요.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# 📊 DART API 키 (선택사항 - 한국 상장기업 공시정보용)
# 금융감독원 전자공시시스템(DART)의 API 키입니다.
# https://opendart.fss.or.kr/ 에서 무료로 발급받을 수 있어요.
# 한국 주식 분석 시 더 상세한 정보를 제공합니다.
DART_API_KEY=YOUR_DART_API_KEY_HERE

# 🌐 기타 설정들 (선택사항)
# 대시보드의 동작을 세밀하게 조정할 수 있는 설정들이에요.

# 분석 결과 저장 폴더 (기본값: results)
RESULTS_DIRECTORY=results

# 로그 레벨 설정 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 최대 분석 시간 (초 단위, 기본값: 300초 = 5분)
MAX_ANALYSIS_TIME=300

# PDF 분석 최대 파일 크기 (MB 단위, 기본값: 50MB)
MAX_PDF_SIZE=50

# 💡 보안 주의사항:
# - 이 파일에는 중요한 API 키가 들어있으니 절대 다른 사람과 공유하지 마세요!
# - GitHub 등에 업로드할 때 .gitignore에 .env 파일이 포함되어 있는지 확인하세요!
# - API 키가 노출되면 요금이 부과될 수 있으니 조심하세요!
